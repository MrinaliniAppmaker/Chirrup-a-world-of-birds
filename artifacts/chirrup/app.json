{
  "expo": {
    "name": "CHIRRUP",
    "slug": "chirrup",
    "owner": "mrinaliniappmaker",
    "extra": {
      "eas": {
        "projectId": "f3a06196-821b-4ef5-9b84-fa99bdfc72e1"
      }
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/chirrup-icon.png",
    "scheme": "chirrup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "app.chirrupaworldofbirdsgeneratingapp.mrinalinikhetan",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/chirrup-icon.png",
        "backgroundColor": "#F5F2EA"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/chirrup-icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Chirrup to use a photo you choose for your profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
