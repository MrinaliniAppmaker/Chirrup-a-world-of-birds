{
  "expo": {
    "name": "CHIRRUP",
    "slug": "chirrup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/chirrup-icon.png",
    "scheme": "chirrup",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "app.ChirrupAWorldOfBirdsGeneratingApp.MrinaliniKhetan"
    },
    "web": {
      "favicon": "./assets/images/chirrup-icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
